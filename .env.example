# Database — set this in Netlify / your host (never commit real credentials)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Owner account — created on first run. Set real values only in Netlify env vars.
OWNER_EMAIL=your-email@example.com
OWNER_PASSWORD=your-secure-password

# Session signing secret. Set this explicitly in production so sessions survive restarts.
AUTH_SECRET=
