# Database (set automatically in this sandbox; use your Postgres/Supabase URL in production)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Owner account — created on first run. Change these before deploying.
OWNER_EMAIL=owner@meda.crm
OWNER_PASSWORD=meda-crm

# Session signing secret. If unset, a random secret is generated and stored in the DB.
# Set this explicitly on Vercel so sessions survive across instances.
AUTH_SECRET=
